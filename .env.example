# Local values are generated automatically by `npm run local:start`.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SUPABASE_BACKEND_URL=http://host.docker.internal:54321
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this value to the browser.
SUPABASE_SECRET_KEY=

# Local Supabase PostgreSQL as reached from the SiteOps backend container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:54322/postgres

# One-time bootstrap. Remove the password after the Super Admin is linked.
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@siteops.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# One-time legacy migration only. Remove after running the linking command.
MIGRATION_TEMP_PASSWORD=

VITE_API_BASE=http://localhost:8000
# Set on the Vercel deployment to the real production frontend URL.
# Leave unset locally - it falls back to window.location.origin.
# Pins where password-reset emails redirect to, so triggering "Send reset
# email"/"Forgot password" from a local dev session never sends the link
# back to localhost instead of the deployed site.
VITE_FRONTEND_URL=

FRONTEND_URL=http://localhost:3000

# Meta WhatsApp Cloud API (see backend/app/services/whatsapp_provider.py).
# From Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Signs inbound webhook deliveries (see backend/app/routes/whatsapp_webhook_v2.py).
# An arbitrary secret you generate yourself and also enter in Meta's
# WhatsApp > Configuration > Webhooks page.
WHATSAPP_WEBHOOK_SECRET=
# One-time subscription handshake token for the same page - a second,
# separate arbitrary string, not the signing secret above.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Set to "doubletick" to send through DoubleTick instead of Meta's Graph API,
# for a number onboarded through DoubleTick. Empty means Meta.
WHATSAPP_PROVIDER=
# DoubleTick > Settings > Developer API, and the connected sender number
# in international format (+91...).
DOUBLETICK_API_KEY=
DOUBLETICK_FROM_NUMBER=
